# =========================================================================
# General & Secrets
# =========================================================================
# Environment variables.
# Do not commit secrets or local environment configurations.
# It's good practice to have an `example.env` file checked in.
.env
.env.*
!.env.example

# Log files
*.log
debug.log


# =========================================================================
# IDEs & Editors
# =========================================================================
# IntelliJ / CLion / RustRover
.idea/

# Visual Studio Code
.vscode/


# =========================================================================
# Rust / Cargo
# =========================================================================
# Compiled build artifacts, dependencies, and intermediate files.
/target/

# Generated by `cargo-profile`
/profile.json

# Generated by `rust-analyzer` for IDEs
/rust-project.json


# =========================================================================
# Solidity / Foundry
# =========================================================================
# This section provides general rules. The specific example at `examples/eth/`
# can have its own more detailed .gitignore file.

# Compiled contract artifacts and cache
/out/
/cache/
artifacts/

# Dependencies installed with `forge install`.
# Be cautious if you use git submodules for dependencies in this directory.
/lib/

# Foundry broadcast logs for local development blockchains.
# The negation pattern ensures template files in /broadcast are NOT ignored.
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Generated documentation
/docs/


# =========================================================================
# OS-specific files
# =========================================================================
# macOS
.DS_Store

# Windows
Thumbs.db